PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
TRUST_PROXY=0
# Choose ONE MongoDB connection string. Local MongoDB example:
MONGODB_URI=mongodb://127.0.0.1:27017/personal_ai_assistant
# MongoDB Atlas SRV example (replace all placeholders):
# MONGODB_URI=mongodb+srv://<db_user>:<url_encoded_password>@<cluster-host>/personal_ai_assistant?retryWrites=true&w=majority&appName=PersonalAI
# MongoDB Atlas Standard / non-SRV example: copy the exact host list and replicaSet from Atlas > Connect > Drivers.
# MONGODB_URI=mongodb://<db_user>:<url_encoded_password>@<node-0>:27017,<node-1>:27017,<node-2>:27017/personal_ai_assistant?tls=true&replicaSet=<replica-set-name>&authSource=admin&retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6-astra
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Optional endpoint override; usually leave unset.
# AI_BASE_URL=
TAVILY_API_KEY=your-tavily-api-key
MAX_FILE_MB=25
ENABLE_OCR=false
OCR_LANGUAGES=eng+ben
# Browser navigation runs in a headless Playwright browser only after approval.
# Install browser binaries with: npx playwright install chromium
# Code execution requires Docker, pre-pulled images, and explicit approval.
ENABLE_DOCKER_CODE=false
PYTHON_DOCKER_IMAGE=python:3.12-slim
NODE_DOCKER_IMAGE=node:22-slim
